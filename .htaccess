# Protección de la Base de Datos SQLite
<Files "database.sqlite">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Protección de archivos de configuración
<FilesMatch "\.(sqlite|db|json|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Permitir index.html como página de inicio
DirectoryIndex index.html

# Configuración UTF-8
AddDefaultCharset UTF-8
